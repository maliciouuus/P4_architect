{
  "info": {
    "name": "DataShare API",
    "description": "Collection complète des endpoints DataShare MVP — NestJS + JWT",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.0.0"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api", "type": "string" },
    { "key": "token",    "value": "",                          "type": "string" },
    { "key": "share_token", "value": "",                       "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register — Créer un compte",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"username\": \"alice\",\n  \"password\": \"motdepasse123\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Pas de mot de passe dans la réponse', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.not.have.property('password');",
                  "  pm.expect(body).to.have.property('id');",
                  "  pm.expect(body).to.have.property('email');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login — Connexion",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"motdepasse123\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Token JWT présent', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('access_token');",
                  "  pm.collectionVariables.set('token', body.access_token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login — Mauvais mot de passe (401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"mauvaismdp\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('Message générique (pas de révélation email/mdp)', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.message).to.equal('Identifiants invalides.');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Me — Profil utilisateur connecté",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/auth/me", "host": ["{{base_url}}"], "path": ["auth", "me"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Profil sans mot de passe', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('email');",
                  "  pm.expect(body).to.not.have.property('password');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Me — Sans token (401)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/auth/me", "host": ["{{base_url}}"], "path": ["auth", "me"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 sans token', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Fichiers",
      "item": [
        {
          "name": "Upload — Fichier avec compte (US01)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/files/upload", "host": ["{{base_url}}"], "path": ["files", "upload"] },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file",         "type": "file",  "src": "/chemin/vers/fichier.txt" },
                { "key": "expiry_hours", "type": "text",  "value": "48" },
                { "key": "password",     "type": "text",  "value": "" }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('share_url présent', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('share_url');",
                  "  pm.expect(body.is_expired).to.be.false;",
                  "  const token = body.share_url.split('/download/')[1];",
                  "  pm.collectionVariables.set('share_token', token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload — Fichier .exe refusé (403)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/files/upload", "host": ["{{base_url}}"], "path": ["files", "upload"] },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "/chemin/vers/virus.exe" }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 403 extension interdite', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload — Anonyme sans compte (US07)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/files/upload/anonymous", "host": ["{{base_url}}"], "path": ["files", "upload", "anonymous"] },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "/chemin/vers/fichier.txt" }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('share_url présent (ownerId null)', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('share_url');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Historique — Liste des fichiers (US05)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/files", "host": ["{{base_url}}"], "path": ["files"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Tableau de fichiers', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Historique — Sans token (401)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/files", "host": ["{{base_url}}"], "path": ["files"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 sans token', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Partage — Métadonnées publiques (US02)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/files/share/{{share_token}}", "host": ["{{base_url}}"], "path": ["files", "share", "{{share_token}}"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Métadonnées sans chemin disque', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('original_name');",
                  "  pm.expect(body).to.have.property('size');",
                  "  pm.expect(body).to.have.property('expires_at');",
                  "  pm.expect(body).to.not.have.property('file_path');",
                  "  pm.expect(body).to.not.have.property('password_hash');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Téléchargement — Lien valide (US02)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/files/download/{{share_token}}", "host": ["{{base_url}}"], "path": ["files", "download", "{{share_token}}"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Header Content-Disposition présent', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Disposition')).to.include('attachment');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Téléchargement — Token invalide (404)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/files/download/token-inexistant", "host": ["{{base_url}}"], "path": ["files", "download", "token-inexistant"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404 token inconnu', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Suppression — Fichier propriétaire (US06)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/files/ID_DU_FICHIER", "host": ["{{base_url}}"], "path": ["files", "ID_DU_FICHIER"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 suppression OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Suppression — Sans token (401)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/files/ID_DU_FICHIER", "host": ["{{base_url}}"], "path": ["files", "ID_DU_FICHIER"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 sans token', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
