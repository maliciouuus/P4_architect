{
  "info": {
    "name": "DataShare API",
    "description": "Collection complète des endpoints DataShare MVP — NestJS + JWT",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.1.0"
  },
  "variable": [
    { "key": "base_url",    "value": "http://localhost:8000/api", "type": "string" },
    { "key": "token",       "value": "",                          "type": "string" },
    { "key": "share_token", "value": "",                          "type": "string" },
    { "key": "file_id",     "value": "",                          "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Register — Créer un compte",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"username\": \"alice\",\n  \"password\": \"motdepasse123\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Retourne id + email sans mot de passe', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('id');",
                  "  pm.expect(body).to.have.property('email');",
                  "  pm.expect(body).to.not.have.property('password');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Login — Connexion (stocke le token)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"motdepasse123\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Token JWT présent et stocké', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('access_token');",
                  "  pm.collectionVariables.set('token', body.access_token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Login — Mauvais mot de passe → 401",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"mauvaismdp\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('Message générique — pas de révélation email/mdp', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.message).to.equal('Identifiants invalides.');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Me — Profil utilisateur connecté",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/auth/me", "host": ["{{base_url}}"], "path": ["auth", "me"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Profil sans mot de passe', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('email');",
                  "  pm.expect(body).to.not.have.property('password');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Me — Sans token → 401",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/auth/me", "host": ["{{base_url}}"], "path": ["auth", "me"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 sans token', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Fichiers",
      "item": [
        {
          "name": "6. Liste fichiers — authentifié (US05)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/files", "host": ["{{base_url}}"], "path": ["files"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Retourne un tableau', () => {",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "7. Liste fichiers — sans token → 401",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/files", "host": ["{{base_url}}"], "path": ["files"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 sans token', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "8. Upload fichier — sans mot de passe (US01)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/files/upload", "host": ["{{base_url}}"], "path": ["files", "upload"] },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file",         "type": "file", "src": [] },
                { "key": "expiry_hours", "type": "text", "value": "48" }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('share_url et file_id stockés', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('share_url');",
                  "  pm.expect(body).to.have.property('share_token');",
                  "  pm.expect(body.is_expired).to.be.false;",
                  "  pm.collectionVariables.set('share_token', body.share_token);",
                  "  pm.collectionVariables.set('file_id', body.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "9. Upload fichier — avec mot de passe (US09)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/files/upload", "host": ["{{base_url}}"], "path": ["files", "upload"] },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file",         "type": "file", "src": [] },
                { "key": "expiry_hours", "type": "text", "value": "24" },
                { "key": "password",     "type": "text", "value": "secret123" }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Fichier protégé par mot de passe', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.is_password_protected).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "10. Upload — Extension interdite .exe → 403",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/files/upload", "host": ["{{base_url}}"], "path": ["files", "upload"] },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [] }
              ]
            },
            "description": "Sélectionner un fichier .exe dans le file picker"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 403 extension interdite', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "11. Upload anonyme — sans compte (US07)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/files/upload/anonymous", "host": ["{{base_url}}"], "path": ["files", "upload", "anonymous"] },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file",         "type": "file", "src": [] },
                { "key": "expiry_hours", "type": "text", "value": "24" }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('share_url présent — pas de compte requis', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('share_url');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "12. Métadonnées publiques — lien valide (US02)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/files/share/{{share_token}}", "host": ["{{base_url}}"], "path": ["files", "share", "{{share_token}}"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Métadonnées sans données sensibles', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('original_name');",
                  "  pm.expect(body).to.have.property('size');",
                  "  pm.expect(body).to.have.property('expires_at');",
                  "  pm.expect(body).to.not.have.property('file_path');",
                  "  pm.expect(body).to.not.have.property('password_hash');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "13. Métadonnées publiques — token inconnu → 404",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/files/share/token-inexistant", "host": ["{{base_url}}"], "path": ["files", "share", "token-inexistant"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404 token inconnu', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "14. Téléchargement — lien valide (US02)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/files/download/{{share_token}}", "host": ["{{base_url}}"], "path": ["files", "download", "{{share_token}}"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Header Content-Disposition présent', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Disposition')).to.include('attachment');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "15. Téléchargement — token inconnu → 404",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/files/download/token-inexistant", "host": ["{{base_url}}"], "path": ["files", "download", "token-inexistant"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404 token inconnu', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "16. Suppression — propriétaire (US06)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/files/{{file_id}}", "host": ["{{base_url}}"], "path": ["files", "{{file_id}}"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 suppression OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "17. Suppression — sans token → 401",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/files/{{file_id}}", "host": ["{{base_url}}"], "path": ["files", "{{file_id}}"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 sans token', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
